---
import PortalLayout from '../layouts/PortalLayout.astro';
import { mailto, site, cc, igUrl } from '../data/site';
import { eventBeats } from '../data/cc-catalogue';
import '../styles/cc.css';

const ig = igUrl(cc.instagram);
---

<PortalLayout
  portal="cc"
  title="Cultural Crossroads"
  description="Gatherings with a point of view — event nights from Instagram, weddings into colleges and corporates. Hyderabad."
>
  <section class="cc-hero">
    <div class="cc-hero__bg" aria-hidden="true"></div>
    <div class="wrap">
      <img
        class="cc-hero__logo hero-wordmark"
        src="/assets/cc/logo.svg"
        alt=""
        width="72"
        height="72"
      />
      <h1 class="hero-tagline">Cultural Crossroads</h1>
      <p class="cc-hero__line hero-support">Gatherings, held with a point of view.</p>
      <p class="cc-hero__sub">
        Events house — weddings, birthdays, and private rooms first, expanding into colleges and
        corporates.
      </p>
      <div class="cta-row hero-ctas" style="margin-top: 0.5rem">
        <a class="cta" href={ig} target="_blank" rel="noopener noreferrer">
          Instagram @{cc.instagram}
        </a>
        <a class="cta" href="#nights">Nights timeline</a>
        <a class="cta" href="/cc/rentals">CC Rentals →</a>
      </div>
    </div>
  </section>

  <section class="section chapter field-ivory" id="about">
    <div class="wrap">
      <p class="kicker">What we are</p>
      <h2 class="display display-lg">The events house.</h2>
      <div class="split-two">
        <div>
          <h3>Events</h3>
          <p>
            Cultural Crossroads holds cultural nights, private rooms, and brand gatherings. The
            evening is held — not decorated for the feed alone.
          </p>
        </div>
        <div>
          <h3>CC Rentals</h3>
          <p>
            Premium pieces for the day live on a separate desk.
            <a href="/cc/rentals">Open the rentals catalogue →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive nights timeline — event posts only -->
  <section class="section chapter" id="nights">
    <div class="wrap">
      <p class="kicker">Nights · from Instagram</p>
      <h2 class="display display-lg">Notable rooms across the years.</h2>
      <p class="lead" style="margin-top: 1rem">
        Birthday lands, half-saree boards, housewarming dumps, wedding floors — scrub the timeline.
        Drag the stills. Full trail on @{cc.instagram}.
      </p>

      <div class="tl" data-timeline>
        <div class="tl__track" aria-hidden="true">
          <div class="tl__fill" data-tl-fill></div>
        </div>

        <div class="tl__beats" role="tablist" aria-label="Event timeline">
          {
            eventBeats.map((beat, i) => (
              <button
                type="button"
                class:list={['tl__beat', { 'is-active': i === 0 }]}
                data-beat={i}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                <em>
                  {beat.when} · {beat.label}
                </em>
                <strong>{beat.title}</strong>
              </button>
            ))
          }
        </div>

        {
          eventBeats.map((beat, i) => (
            <div
              class:list={['tl__panel', { 'is-active': i === 0 }]}
              data-panel={i}
              role="tabpanel"
              hidden={i !== 0}
            >
              <div class="tl-shot-rail" data-shot-rail>
                {beat.images.map((img) => (
                  <figure class="tl-shot">
                    <img src={img.src} alt={img.alt} loading="lazy" width="800" height="1000" />
                  </figure>
                ))}
              </div>
              <div class="tl-copy">
                <p class="meta">
                  {beat.when} · {beat.label}
                </p>
                <h3>{beat.title}</h3>
                <p>{beat.blurb}</p>
                <a class="cta" href={beat.instagram} target="_blank" rel="noopener noreferrer">
                  Open on Instagram →
                </a>
              </div>
            </div>
          ))
        }

        <div class="tl__nav">
          <button type="button" data-tl-prev>Prev</button>
          <button type="button" data-tl-next>Next</button>
          <a class="cta" href={ig} target="_blank" rel="noopener noreferrer">
            Full Instagram grid
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section chapter field-ivory" id="expand">
    <div class="wrap">
      <p class="kicker">How we expand</p>
      <h2 class="display display-lg">Weddings → colleges → corporates.</h2>
      <p class="lead" style="margin-top: 1.1rem">
        Same care for the room. Wider calendar. Clearer name on the door.
      </p>
      <div class="path" aria-label="Expansion path">
        <article class="path-step">
          <span class="n">01</span>
          <div>
            <h3>Weddings &amp; family</h3>
            <p>Private rooms, birthdays, housewarmings — the root we do not leave behind.</p>
          </div>
        </article>
        <div class="path-arrow" aria-hidden="true">→</div>
        <article class="path-step">
          <span class="n">02</span>
          <div>
            <h3>Colleges</h3>
            <p>Fest, nights, farewells — one list from campus, one house on the dates.</p>
          </div>
        </article>
        <div class="path-arrow" aria-hidden="true">→</div>
        <article class="path-step">
          <span class="n">03</span>
          <div>
            <h3>Corporates</h3>
            <p>Brand rooms with clear scope, named vendors, no surprise add-ons.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section chapter" id="contact">
    <div class="wrap">
      <p class="kicker">Contact</p>
      <h2 class="display display-lg">Tell us the date and the room.</h2>
      <p class="lead" style="margin-top: 1rem">
        {site.email} · {site.phoneDisplay}
      </p>
      <div class="subject-row cta-row">
        <a class="cta" href={mailto('Wedding / family room')}>Wedding / family</a>
        <a class="cta" href={mailto('Birthday / cradle')}>Birthday / cradle</a>
        <a class="cta" href={mailto('College gathering')}>College</a>
        <a class="cta" href={mailto('Corporate date')}>Corporate</a>
        <a class="cta" href="/cc/rentals">Rentals catalogue</a>
      </div>
      <div class="cta-band">
        <a class="cta" href={ig} target="_blank" rel="noopener noreferrer">
          @{cc.instagram}
        </a>
        <a class="cta" href={`mailto:${site.email}`}>Email</a>
        <a class="cta" href={`tel:${site.phoneTel}`}>Call / WhatsApp</a>
      </div>
    </div>
  </section>

  <script>
    import { initCcTimeline } from '../scripts/cc-timeline';
    initCcTimeline();
  </script>
</PortalLayout>
