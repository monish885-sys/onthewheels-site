{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ventures",
      "destination": "/cc",
      "permanent": true
    },
    {
      "source": "/ventures/:path*",
      "destination": "/cc",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cc.onthewheels.in" }],
      "destination": "/cc",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "18g.onthewheels.in" }],
      "destination": "/18g",
      "permanent": false
    }
  ]
}
